{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Control de Asistencia - Panel Administrativo",
  "short_name": "Asistencias",
  "description": "Plataforma Institucional de Supervisión y Control de Asistencia para Medidas Judiciales de Familia",
  "start_url": "/",
  "id": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#faf9f6",
  "theme_color": "#7a1c2e",
  "orientation": "any",
  "lang": "es-PE",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": [
    "government",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Panel Principal",
      "short_name": "Dashboard",
      "description": "Resumen operativo en tiempo real",
      "url": "/",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Beneficiarios",
      "short_name": "Beneficiarios",
      "description": "Padrón general y expedientes judiciales",
      "url": "/beneficiarios",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Control de Asistencias",
      "short_name": "Asistencias",
      "description": "Marcaciones y registro de firmas",
      "url": "/asistencias",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Bandeja de Justificaciones",
      "short_name": "Justificaciones",
      "description": "Revisión de comprobantes y solicitudes",
      "url": "/justificaciones",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}